# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Swift, Metal, and C/C++ source code
*.swift text diff=swift eol=lf
*.metal text diff=cpp eol=lf
*.h text diff=cpp eol=lf
*.hpp text diff=cpp eol=lf
*.c text diff=cpp eol=lf
*.cpp text diff=cpp eol=lf
*.m text diff=objc eol=lf
*.mm text diff=objc eol=lf

# Configuration and Documentation
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.plist text eol=lf
*.xml text eol=lf
*.xcdatamodel text eol=lf
*.xcdatamodeld text eol=lf

# Xcode project file merge driver
*.pbxproj merge=union

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.tiff binary
*.webp binary
*.icns binary
*.pdf binary

# Camera RAW formats (if sample assets are included)
*.arw binary
*.cr2 binary
*.cr3 binary
*.nef binary
*.dng binary
*.orf binary
*.rw2 binary
